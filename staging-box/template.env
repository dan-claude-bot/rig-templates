# staging-box — the server tenant from box#69. Its tailnet workload join stays
# operator-run (`box shell` then `rig bootstrap workload-server`) because that
# step holds a credential; the registry converge is docker + sshd hardening.
USER="ops"
AGENT="no"
HARDEN_SSHD="yes"
SWAP_SIZE="4G"
USER_SUDO="nopasswd"
